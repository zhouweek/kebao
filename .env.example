# 留空时 API 使用内存仓储；设置后自动使用 Prisma/PostgreSQL。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kebao?schema=public"
POSTGRES_IMAGE="public.ecr.aws/docker/library/postgres:16-alpine"
# 仅限本地联调。连接数据库时默认禁用请求头身份，显式设为 true 才启用。
DEV_IDENTITY_ENABLED=false
# 数据库模式必须替换为高强度随机值；用于签发 Bearer 访问令牌。
AUTH_TOKEN_SECRET="replace-with-at-least-32-random-characters"
# 微信服务端认证配置：用于 code2session、access_token 和 getuserphonenumber。
# access_token 由 API 进程按微信返回的有效期缓存；未配置时微信登录接口返回 503。
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# 微信订阅消息模板 ID。模板需包含 thing1（标题）和 thing2（内容）。
WECHAT_TEMPLATE_BOOKING_CONFIRMED=""
WECHAT_TEMPLATE_BOOKING_CANCELLED=""
WECHAT_TEMPLATE_SESSION_RESCHEDULED=""
WECHAT_TEMPLATE_SESSION_CANCELLED=""
WECHAT_TEMPLATE_SESSION_REMINDER_24H=""
WECHAT_TEMPLATE_SESSION_REMINDER_2H=""
WECHAT_MINIPROGRAM_STATE="formal"
WECHAT_SUBSCRIBE_LANGUAGE="zh_CN"
# 通知 Outbox 扫描周期，最小 10000 毫秒。
NOTIFICATION_WORKER_INTERVAL_MS=60000
# 仅用于开发种子管理员，生产环境不要复用。
SEED_ADMIN_PASSWORD="Admin123!"
# 两端开发身份请求头必须分别显式开启，默认均使用 Bearer。
VITE_DEV_IDENTITY_ENABLED=false
TARO_APP_DEV_IDENTITY_ENABLED=false
TARO_APP_API_BASE_URL="http://localhost:3000"
PORT=3000
HOST=0.0.0.0
# HTTP 安全与可观测性（生产环境 CORS 仅接受 HTTPS 来源）。
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
# 生产环境必须替换；用于保护 /metrics。
METRICS_TOKEN="replace-with-a-random-metrics-token"
