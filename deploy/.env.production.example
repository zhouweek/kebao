POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=kebao
POSTGRES_USER=kebao
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://kebao:replace-with-url-encoded-password@postgres:5432/kebao?schema=public
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
PLATFORM_AUTH_TOKEN_SECRET=replace-with-another-32-random-characters
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
PLATFORM_ADMIN_PASSWORD_VERSION=1
METRICS_TOKEN=replace-with-a-random-monitoring-token
CORS_ORIGINS=https://admin.example.com
TLS_CERT_DIR=/absolute/path/to/tls
HTTP_PORT=80
HTTPS_PORT=443
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
NOTIFICATION_WORKER_INTERVAL_MS=60000
WECHAT_APP_ID=
WECHAT_APP_SECRET=
