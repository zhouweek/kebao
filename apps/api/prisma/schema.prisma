generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
  FINISHED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COURSE_CANCELLED
  ATTENDED
  LEAVE
  ABSENT
}

enum NotificationType {
  SESSION_RESCHEDULED
  SESSION_CANCELLED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  SESSION_REMINDER_24H
  SESSION_REMINDER_2H
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum UserRole {
  ADMIN
  TEACHER
  GUARDIAN
}

model Organization {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  isActive   Boolean         @default(true)
  deletedAt  DateTime?
  campuses   Campus[]
  users      User[]
  students   Student[]
  courses    Course[]
  classrooms Classroom[]
  sessions   CourseSession[]
  scheduleSeries ScheduleSeries[]
  bookings   Booking[]
  guardians  StudentGuardian[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]
  auditLogs     AuditLog[]
  authSessions  AuthSession[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model PlatformAccount {
  id           String            @id @default(cuid())
  username     String            @unique
  name         String
  passwordHash String
  passwordVersion Int            @default(1)
  isActive     Boolean           @default(true)
  mustChangePassword Boolean      @default(true)
  lastLoginAt  DateTime?
  sessions     PlatformSession[]
  auditLogs    PlatformAuditLog[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PlatformSession {
  id               String          @id @default(cuid())
  accountId        String
  account          PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokenHash String          @unique
  expiresAt        DateTime        @db.Timestamptz(3)
  revokedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([accountId, expiresAt])
}

model PlatformAuditLog {
  id         String          @id @default(cuid())
  actorId    String
  actor      PlatformAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime        @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ScheduleSeries {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recurrence       String          @default("WEEKLY")
  intervalWeeks    Int             @default(1)
  requestedCount   Int
  createdBy        String
  sessions         CourseSession[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}

model Campus {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  timezone       String          @default("Asia/Shanghai")
  isActive       Boolean         @default(true)
  classrooms     Classroom[]
  students       Student[]
  sessions       CourseSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model User {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            UserRole
  name            String
  phone           String?
  email           String?
  specialty       String?
  remark          String?
  passwordHash    String?
  wechatOpenId    String?
  isActive        Boolean           @default(true)
  mustChangePassword Boolean         @default(false)
  lastLoginAt     DateTime?
  teacherSessions CourseSession[] @relation("SessionTeacher")
  guardianLinks   StudentGuardian[]
  notifications   Notification[]
  notificationDeliveries NotificationDelivery[]
  authSessions    AuthSession[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, phone])
  @@unique([organizationId, wechatOpenId])
  @@index([organizationId, role])
}

model AuthSession {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  refreshTokenHash String       @unique
  expiresAt        DateTime     @db.Timestamptz(3)
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, userId, expiresAt])
}

model Student {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  gender          String?
  birthDate       DateTime?         @db.Date
  campusId        String?
  campus          Campus?           @relation(fields: [campusId, organizationId], references: [id, organizationId])
  remark          String?
  isActive        Boolean           @default(true)
  guardianLinks   StudentGuardian[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([organizationId, campusId])
}

model StudentGuardian {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  guardianId     String
  guardian       User         @relation(fields: [guardianId, organizationId], references: [id, organizationId], onDelete: Cascade)
  relationship   String       @default("监护人")
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@id([organizationId, studentId, guardianId])
  @@index([organizationId, guardianId])
}

model Course {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  durationMinutes Int
  description    String?
  isActive       Boolean         @default(true)
  sessions       CourseSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model Classroom {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campusId       String
  campus         Campus          @relation(fields: [campusId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name           String
  code           String?
  capacity       Int
  isActive       Boolean         @default(true)
  sessions       CourseSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, campusId, name])
  @@unique([organizationId, campusId, code])
}

model CourseSession {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course        @relation(fields: [courseId, organizationId], references: [id, organizationId])
  campusId         String
  campus           Campus        @relation(fields: [campusId, organizationId], references: [id, organizationId])
  classroomId      String?
  classroom        Classroom?    @relation(fields: [classroomId, organizationId], references: [id, organizationId])
  teacherId        String
  teacher          User          @relation("SessionTeacher", fields: [teacherId, organizationId], references: [id, organizationId])
  startsAt         DateTime      @db.Timestamptz(3)
  endsAt           DateTime      @db.Timestamptz(3)
  capacity         Int
  status           SessionStatus @default(PUBLISHED)
  bookingOpensAt   DateTime      @db.Timestamptz(3)
  bookingClosesAt  DateTime      @db.Timestamptz(3)
  cancelDeadlineAt DateTime      @db.Timestamptz(3)
  seriesId         String?
  series            ScheduleSeries? @relation(fields: [seriesId, organizationId], references: [id, organizationId], onDelete: Cascade)
  occurrenceIndex  Int?
  bookings         Booking[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, teacherId, startsAt, endsAt])
  @@index([organizationId, classroomId, startsAt, endsAt])
  @@index([organizationId, campusId, startsAt])
  @@unique([organizationId, seriesId, occurrenceIndex])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        CourseSession @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId, organizationId], references: [id, organizationId])
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, sessionId, studentId])
  @@index([organizationId, studentId, status])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           NotificationType
  title          String
  content        String
  sessionId      String?
  idempotencyKey String?
  deliveries     NotificationDelivery[]
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification               @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String
  user           User                       @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  channel        String                     @default("WECHAT")
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  lastError      String?
  idempotencyKey String
  payload        Json
  nextAttemptAt  DateTime                   @default(now()) @db.Timestamptz(3)
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  action         String
  entityType     String
  entityId       String
  details        Json
  createdAt      DateTime     @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
